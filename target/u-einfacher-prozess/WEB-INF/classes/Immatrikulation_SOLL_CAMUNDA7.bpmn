    <bpmn:textAnnotation id="TextAnnotation_0ixpg0l">
      <bpmn:text>Wird nur aus table "studenten" gelöscht, Imma-Antrag wird jedoch behalten. (Falls Student Studienplatz anfechten sollte o.Ä.)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0c1aefq" associationDirection="None" sourceRef="Activity_1oltu2o" targetRef="TextAnnotation_0ixpg0l" />
    <bpmn:textAnnotation id="TextAnnotation_0kwndec">
      <bpmn:text>Type: müsste 'Date' sein aber in diesem fall 1 Sekunde 'Duration' da es ein Prototyp ist</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_02tka2j" associationDirection="None" sourceRef="Event_131z3r5" targetRef="TextAnnotation_0kwndec" />
    <bpmn:textAnnotation id="TextAnnotation_1gxijm4">
      <bpmn:text>Richtet sich nach besten Noten und max_anzahl_zulassen von DB. Random choice verteilung wern zwei mit selber Note um den letzten Platz kämpfen (fairness)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xjeo83" associationDirection="None" sourceRef="Activity_15xm0i3" targetRef="TextAnnotation_1gxijm4" />
    <bpmn:textAnnotation id="TextAnnotation_1t9vfz6">
      <bpmn:text>Bewerber aus System löschen (siehe am Ende des BPMN unterer Zweig) könnte man hier auch nochmal kopieren und einsetzen, wenn man möchte.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0timpx8" associationDirection="None" sourceRef="TextAnnotation_1t9vfz6" targetRef="Flow_06ibuhq" />
  </bpmn:process>
